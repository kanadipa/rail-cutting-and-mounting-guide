{
  "name": "rail-guide-server",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "dotenv -e ../.env -- nest start --watch",
    "db:wait": "dotenv -e ../.env -- tsx prisma/waitForDb.ts",
    "db:generate": "prisma generate",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../.env -- prisma db seed",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@swc/core": "^1.11.0",
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "@types/three": "~0.160.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "three": "~0.160.0",
    "tsx": "^4.19.0",
    "unplugin-swc": "^1.5.1"
  }
}
